# GoHighLevel Environment Variables
# Copy this file to .env and fill in your values.
#
# To get your Private Integration Token:
#   1. Go to your GHL sub-account > Settings > Integrations > API Key
#   2. Copy the Private Integration Token
#
# To find your Location ID:
#   1. Go to your GHL sub-account > Settings > Business Profile
#   2. The Location ID is in the URL or Business Info section

GHL_API_KEY=your-private-integration-token-here
GHL_LOCATION_ID=your-location-id-here
